#!/bin/bash
# ============================================================
# vllm_run — GitHub 公开版（2026-08-30）
# 已隐去服务器 IP / 端口 / 用户名等个人信息；
# 部署功能与服务器实测版一致（KV 8.4GB、expandable_segments、
# --cap-add SYS_PTRACE、PLE CPU 卸载、MTP 投机解码）。
# 使用时请按需修改：CONTAINER_NAME / PORT_MAP / MODEL_NAME / SERVED_NAME。
# ============================================================
set -e

usage() {
cat <<'EOF'
vllm_run - vLLM 多卡部署启动脚本

说明:
  这是一个用于在 Ubuntu 服务器上通过 Docker + NVIDIA Container Toolkit
  启动 vLLM OpenAI 兼容服务的脚本。无需 sudo/root，日志和模型缓存均在
  当前用户 $HOME 下。

用法:
  ./vllm_run [选项]
  ./vllm_run -h|--help

选项:
  -h, --help
      显示本帮助信息并退出；脚本不会启动任何容器。

  --container_name <name>          Docker 容器名
                                   默认: vllm-user
  --image_name <image>             vLLM Docker 镜像
                                   默认: docker.m.daocloud.io/vllm/vllm-openai:qwen38-flash-next
  --port_map <host:container>      端口映射，格式: 宿主机端口:容器端口
                                   默认: 8000:8000
  --model_name <path>              模型路径/名称
                                   默认: /home/user/Project/vllm/models/Qwen3.8-Flash-Next-FP8
  --served_name <name>             API 对外暴露的模型名
                                   默认: Qwen-3.8-Flash-Next
  --display_model_name <name>      API 对外暴露的模型名（--served_name 的别名，二选一）
                                   默认: 同 --served_name
  --num_gpus <n>                   期望使用的 GPU 数量
                                   默认: 由 --tp × --dp 决定（此参数仅作兼容，不再生效）
  --gpu_pin <ids>                  手动指定 GPU，例如 "0,1"
                                   默认: "4,5,6,7"（4卡）；传空字符串 "" 表示自动检测
  --tp <n>                         张量并行度 TP_SIZE
                                   默认: 4（该模型 kv_heads=4 必须整除 TP，只能取 1/2/4）
  --dp <n>                         数据并行副本数 DP_SIZE
                                   默认: 1（TP×DP 必须等于 --gpu_pin 的 GPU 数量，否则启动前报错）
  --max_gpu_index <n>              允许使用的 GPU 编号范围
                                   默认: 7
  --gpu_mem_free_mb <mb>           判断 GPU 空闲的显存阈值
                                   默认: 10000 MB
  --gpu_util_max <pct>             判断 GPU 空闲的利用率阈值
                                   默认: 20%
  --gpu_mem_util <ratio>           期望显存利用率上限
                                   默认: 0.90（固定值，不做自动调整）
  --gpu_mem_safety_mb <mb>         显存安全余量
                                   默认: 3072 MB
  --max_model_len <n>              最大上下文长度（输入+输出 tokens）
                                   默认: 262144（256K）
  --max_num_seqs <n>               最大并发请求数
                                   默认: 2
  --max_batched_tokens <n>         prefill 分块大小（--max-num-batched-tokens）
                                   默认: 4096（可试 16384 提升冷启动 prefill，但首次编译更久）
  --eager_mode <0|1>               1=跳过 CUDA Graph 编译快速启动；0=性能模式
                                   默认: 0
  --eager                          --eager_mode 1 的快捷方式
  --no-eager                       --eager_mode 0 的快捷方式
  --api_key <key>                  API 访问密钥，留空则不启用鉴权
                                   默认: 空
  --timeout_seconds <n>            等待服务就绪超时秒数
                                   默认: 1800（PLE 卸载首次搬 48GiB 表需 5-15 分钟）
  --shm_size <size>                容器共享内存大小
                                   默认: 64g
  --vllm_dir <path>                vLLM 数据目录
                                   默认: ~/Project/vllm
  --hf_endpoint <url>              HuggingFace 镜像地址
                                   默认: https://hf-mirror.com
  --ple_cpu_offload <0|1>         1=把 51B n-gram 表（~48GiB）卸载到主机内存（4C 必开）
                                   默认: 1
  --kv_cache_memory <bytes>       钉死 KV 池大小（字节）；默认: 8400000000（bf16 下 ≈573K token，2×256K + 9% 余量；原 9.6GB 曾致推理期 OOM，2026-08-30 下调）
  --mamba_ssm_dtype <dtype>       线性注意力（GDN）状态精度；默认: bfloat16
  --moe_backend <backend>         MoE 后端；默认: auto（A40 实测自动选 MARLIN）
  --distributed_executor_backend  分布式执行后端；默认: mp（PLE 卸载需要）

GPU 分配逻辑:
  - 若设置了 --gpu_pin，则直接使用指定 GPU，并检查编号是否在 0-$MAX_GPU_INDEX 内；
    对应卡忙时仅告警，不强制阻止启动；要求 --tp × --dp == GPU 数量，否则启动前报错。
  - 若 --gpu_pin 为空，则自动从 nvidia-smi 中筛选满足“已用显存 < --gpu_mem_free_mb
    且利用率 < --gpu_util_max”的空闲 GPU，数量不足（少于 --tp × --dp）时启动前报错。

启动模式:
  --eager_mode 1
      添加 --enforce-eager，跳过 CUDA Graph 编译，通常 1~2 分钟就绪。
  --eager_mode 0（默认）
      性能模式，使用 CUDA Graph、Qwen3.5 MTP 投机解码等优化；
      首次启动可能需要 10~30 分钟编译。

示例:
  ./vllm_run
      使用默认配置启动。
  ./vllm_run --model_name /path/to/model --display_model_name "Your_model_name" --gpu_pin "0,1,2,3,4,5,6,7" --max_model_len 256000 --tp 4 --dp 2
      最常用：指定模型 + 对外名 + 8卡 TP4×DP2 + 256K 上下文。
  ./vllm_run --model_name /path/to/model --served_name my-model
      使用自定义模型和 API 模型名启动。
  ./vllm_run --gpu_pin "0,1"
      手动指定 GPU 0,1 启动，TP=2。
  ./vllm_run --eager_mode 1
      快速启动模式，跳过 CUDA Graph 编译。
  ./vllm_run --max_model_len 16384 --max_num_seqs 4
      调整上下文长度和并发数后启动。

启动成功后的常用命令:
  查看模型列表:     curl http://127.0.0.1:8000/v1/models
  调用 Chat 接口:   curl http://127.0.0.1:8000/v1/chat/completions \
                     -H "Content-Type: application/json" \
                     -d '{"model":"qwen3.8-27b-int8","messages":[{"role":"user","content":"你好"}]}'
  查看容器日志:     docker logs -f vllm-user
  停止服务:         docker stop vllm-user
  彻底删除容器:     docker rm -f vllm-user

注意事项:
  - 使用本地绝对路径模型时，脚本会以只读方式挂载进容器。
  - 多卡 TP 依赖 NVIDIA 容器运行时，需已安装 nvidia-container-toolkit。
  - 服务器上没有 InfiniBand 时，脚本会禁用 NCCL P2P/IB，改用 TCP。
EOF
exit 0
}

# ============================================================
# vLLM 启动脚本  vllm_run （参考 ollama_run 编写）
#
# 功能：
#   1. 自动检测空闲 GPU，支持多卡并发（张量并行 TP）
#   2. 以 Docker 方式启动 vLLM（OpenAI 兼容 API）
#   3. 性能拉满：高显存利用率 + 前缀缓存 + 大并发
#   4. 限制最大上下文长度（输入 + 输出 tokens）
#   5. 指定默认部署模型，模型缓存/日志全部放在 $HOME 下
#
# 注意：全程不需要 sudo/root，只读写当前用户 home 下的目录
# ============================================================

# ========== 修改默认配置的硬性要求 ==========
# ⚠️ 修改任何默认值（GPU_PIN/DP_SIZE/GPU_MEM_UTIL/MAX_MODEL_LEN 等）时，
#    必须同步修改 usage() 帮助文档中的对应说明，否则 ./vllm_run -h 与真实行为不一致！
# ==========================================
# ---------- 基础配置（可通过环境变量临时覆盖，例如 GPU_PIN="0,1" ./vllm_run） ----------
CONTAINER_NAME="${CONTAINER_NAME:-vllm-user}"                          # 容器名（固定）
IMAGE_NAME="${IMAGE_NAME:-vllm-user:latest}"                           # vLLM 镜像
PORT_MAP="${PORT_MAP:-8000:8000}"                                             # 端口映射 宿主机:容器
MODEL_NAME="/home/user/Project/vllm/models/Qwen3.8-Flash-Next-FP8"  # 默认部署模型（本地HF目录，只读挂载）
                                                           #   备用小模型：/home/user/Project/vllm/models/DeepSeek-R1-Distill-Qwen-1.5B
                                                           #   备用多模态模型（本地路径）：/mnt/models/deepseek-ai/deepseek-vl2-tiny
SERVED_NAME="Qwen-3.8-Flash-Next"                       # API 中对外暴露的模型名
NUM_GPUS="${NUM_GPUS:-2}"                                  # 期望使用的显卡数（多卡并发=张量并行；小模型建议设 1）
GPU_PIN="${GPU_PIN:-4,5,6,7}"                                     # 手动指定显卡（留空=自动检测空闲卡；填写如 "2,3,4,5" 则直接使用这4张）
                                                           #   TP=1 单卡最快（本机 NCCL 只有 TCP 路径，TP=2 通信开销 250ms/token）
MAX_GPU_INDEX="${MAX_GPU_INDEX:-7}"                        # 允许使用的 GPU 编号范围 0-7
GPU_MEM_FREE_MB="${GPU_MEM_FREE_MB:-10000}"                # 空闲判定：该卡已用显存 < 10000MB
GPU_UTIL_MAX="${GPU_UTIL_MAX:-20}"                         # 空闲判定：该卡利用率 < 20%
GPU_MEM_UTIL="${GPU_MEM_UTIL:-0.90}"                       # 期望显存利用率上限（性能拉满；实际值会按当前空余显存自动调低）
GPU_MEM_SAFETY_MB="${GPU_MEM_SAFETY_MB:-3072}"             # 显存安全余量（MB），避免与服务器上其他任务抢显存导致启动失败
MAX_MODEL_LEN="${MAX_MODEL_LEN:-262144}"                    # 最大上下文 = 输入 tokens + 输出 tokens（Qwen3.8-27B 支持 256K，按显存预算取 32K）
MAX_NUM_SEQS="${MAX_NUM_SEQS:-2}"
MAX_BATCHED_TOKENS="${MAX_BATCHED_TOKENS:-4096}"    # prefill 分块（--max-num-batched-tokens）；默认 4096，可试 16384
TP_SIZE="${TP_SIZE:-4}"                                                 # 张量并行度（kv_heads=4 必须整除 TP）
DP_SIZE="${DP_SIZE:-1}"                                                 # 数据并行副本数（4卡 = 1组TP4）                          # 最大并发请求数（速度优先，低并发）
EAGER_MODE="${EAGER_MODE:-0}"                              # 1=稳定快速模式（跳过编译，1~2分钟就绪，推荐）；0=性能拉满模式（CUDA Graph，首次启动需编译10~30分钟且共享服务器上可能卡死）
API_KEY="${API_KEY:-}"                                     # 可选：设置后 API 需携带该 key
TIMEOUT_SECONDS="${TIMEOUT_SECONDS:-1800}"                  # 等待服务就绪超时（秒；多模态模型首次编译可能需 10 分钟）
SHM_SIZE="${SHM_SIZE:-64g}"                                 # 容器共享内存大小（多卡 TP 通信需要，默认 64M 不够）
VLLM_DIR="${VLLM_DIR:-/home/user/Project/vllm}"     # 数据目录（模型缓存 models/ + 日志 logs/，参考 Project/ollama）
HF_ENDPOINT="${HF_ENDPOINT:-https://hf-mirror.com}"        # HuggingFace 镜像（下载模型用）
PLE_CPU_OFFLOAD="${PLE_CPU_OFFLOAD:-1}"                          # 1=把 51B n-gram 表（~48GiB）卸载到主机内存（4C 方案必开）
PLE_OFFLOAD_READY_TIMEOUT="${PLE_OFFLOAD_READY_TIMEOUT:-1800}"   # PLE 卸载 ready 超时（秒；首次搬 48GiB 表 + 预热）
KV_CACHE_MEMORY="${KV_CACHE_MEMORY:-8400000000}"                 # 钉死 KV 池大小（字节）≈573K token（2×256K + 9% 余量；原 9.6GB 曾致推理期 OOM，2026-08-30 下调）
MAMBA_SSM_DTYPE="${MAMBA_SSM_DTYPE:-bfloat16}"                   # 线性注意力（GDN）状态精度（每序列状态减半）
ENABLE_EXPERT_PARALLEL="${ENABLE_EXPERT_PARALLEL:-1}"            # 1=开 MoE 专家并行（block-128 FP8 必需）
MOE_BACKEND="${MOE_BACKEND:-auto}"                             # MoE 后端（官方 recipe 指定 triton）
DISTRIBUTED_EXECUTOR_BACKEND="${DISTRIBUTED_EXECUTOR_BACKEND:-mp}" # PLE 卸载 worker 通信需要（mp）
# ---------------------------------------------------------------

# ---------- 命令行参数解析（支持 --xxx value 和 --xxx=value） ----------
while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      ;;
    --container_name=*) CONTAINER_NAME="${1#*=}" ;;
    --container_name)
      [ $# -ge 2 ] || { echo "错误: --container_name 需要一个值" >&2; exit 1; }
      shift; CONTAINER_NAME="$1"
      ;;
    --image_name=*) IMAGE_NAME="${1#*=}" ;;
    --image_name)
      [ $# -ge 2 ] || { echo "错误: --image_name 需要一个值" >&2; exit 1; }
      shift; IMAGE_NAME="$1"
      ;;
    --port_map=*) PORT_MAP="${1#*=}" ;;
    --port_map)
      [ $# -ge 2 ] || { echo "错误: --port_map 需要一个值" >&2; exit 1; }
      shift; PORT_MAP="$1"
      ;;
    --model_name=*) MODEL_NAME="${1#*=}" ;;
    --model_name)
      [ $# -ge 2 ] || { echo "错误: --model_name 需要一个值" >&2; exit 1; }
      shift; MODEL_NAME="$1"
      ;;
    --served_name=*) SERVED_NAME="${1#*=}" ;;
    --served_name)
      [ $# -ge 2 ] || { echo "错误: --served_name 需要一个值" >&2; exit 1; }
      shift; SERVED_NAME="$1"
      ;;
    --display_model_name=*) SERVED_NAME="${1#*=}" ;;
    --display_model_name)
      [ $# -ge 2 ] || { echo "错误: --display_model_name 需要一个值" >&2; exit 1; }
      shift; SERVED_NAME="$1"
      ;;
    --num_gpus=*) NUM_GPUS="${1#*=}" ;;
    --num_gpus)
      [ $# -ge 2 ] || { echo "错误: --num_gpus 需要一个值" >&2; exit 1; }
      shift; NUM_GPUS="$1"
      ;;
    --gpu_pin=*) GPU_PIN="${1#*=}" ;;
    --gpu_pin)
      [ $# -ge 2 ] || { echo "错误: --gpu_pin 需要一个值" >&2; exit 1; }
      shift; GPU_PIN="$1"
      ;;
    --max_gpu_index=*) MAX_GPU_INDEX="${1#*=}" ;;
    --max_gpu_index)
      [ $# -ge 2 ] || { echo "错误: --max_gpu_index 需要一个值" >&2; exit 1; }
      shift; MAX_GPU_INDEX="$1"
      ;;
    --gpu_mem_free_mb=*) GPU_MEM_FREE_MB="${1#*=}" ;;
    --gpu_mem_free_mb)
      [ $# -ge 2 ] || { echo "错误: --gpu_mem_free_mb 需要一个值" >&2; exit 1; }
      shift; GPU_MEM_FREE_MB="$1"
      ;;
    --gpu_util_max=*) GPU_UTIL_MAX="${1#*=}" ;;
    --gpu_util_max)
      [ $# -ge 2 ] || { echo "错误: --gpu_util_max 需要一个值" >&2; exit 1; }
      shift; GPU_UTIL_MAX="$1"
      ;;
    --gpu_mem_util=*) GPU_MEM_UTIL="${1#*=}" ;;
    --gpu_mem_util)
      [ $# -ge 2 ] || { echo "错误: --gpu_mem_util 需要一个值" >&2; exit 1; }
      shift; GPU_MEM_UTIL="$1"
      ;;
    --gpu_mem_safety_mb=*) GPU_MEM_SAFETY_MB="${1#*=}" ;;
    --gpu_mem_safety_mb)
      [ $# -ge 2 ] || { echo "错误: --gpu_mem_safety_mb 需要一个值" >&2; exit 1; }
      shift; GPU_MEM_SAFETY_MB="$1"
      ;;
    --max_model_len=*) MAX_MODEL_LEN="${1#*=}" ;;
    --max_model_len)
      [ $# -ge 2 ] || { echo "错误: --max_model_len 需要一个值" >&2; exit 1; }
      shift; MAX_MODEL_LEN="$1"
      ;;
    --max_num_seqs=*) MAX_NUM_SEQS="${1#*=}" ;;
    --max_num_seqs)
      [ $# -ge 2 ] || { echo "错误: --max_num_seqs 需要一个值" >&2; exit 1; }
      shift; MAX_NUM_SEQS="$1"
      ;;
    --max_batched_tokens=*) MAX_BATCHED_TOKENS="${1#*=}" ;;
    --max_batched_tokens)
      [ $# -ge 2 ] || { echo "错误: --max_batched_tokens 需要一个值" >&2; exit 1; }
      shift; MAX_BATCHED_TOKENS="$1"
      ;;
    --tp=*) TP_SIZE="${1#*=}" ;;
    --tp)
      [ $# -ge 2 ] || { echo "错误: --tp 需要一个值" >&2; exit 1; }
      shift; TP_SIZE="$1"
      ;;
    --dp=*) DP_SIZE="${1#*=}" ;;
    --dp)
      [ $# -ge 2 ] || { echo "错误: --dp 需要一个值" >&2; exit 1; }
      shift; DP_SIZE="$1"
      ;;
    --eager_mode=*) EAGER_MODE="${1#*=}" ;;
    --eager_mode)
      [ $# -ge 2 ] || { echo "错误: --eager_mode 需要一个值" >&2; exit 1; }
      shift; EAGER_MODE="$1"
      ;;
    --eager) EAGER_MODE=1 ;;
    --no-eager) EAGER_MODE=0 ;;
    --api_key=*) API_KEY="${1#*=}" ;;
    --api_key)
      [ $# -ge 2 ] || { echo "错误: --api_key 需要一个值" >&2; exit 1; }
      shift; API_KEY="$1"
      ;;
    --timeout_seconds=*) TIMEOUT_SECONDS="${1#*=}" ;;
    --timeout_seconds)
      [ $# -ge 2 ] || { echo "错误: --timeout_seconds 需要一个值" >&2; exit 1; }
      shift; TIMEOUT_SECONDS="$1"
      ;;
    --shm_size=*) SHM_SIZE="${1#*=}" ;;
    --shm_size)
      [ $# -ge 2 ] || { echo "错误: --shm_size 需要一个值" >&2; exit 1; }
      shift; SHM_SIZE="$1"
      ;;
    --vllm_dir=*) VLLM_DIR="${1#*=}" ;;
    --vllm_dir)
      [ $# -ge 2 ] || { echo "错误: --vllm_dir 需要一个值" >&2; exit 1; }
      shift; VLLM_DIR="$1"
      ;;
    --hf_endpoint=*) HF_ENDPOINT="${1#*=}" ;;
    --hf_endpoint)
      [ $# -ge 2 ] || { echo "错误: --hf_endpoint 需要一个值" >&2; exit 1; }
      shift; HF_ENDPOINT="$1"
      ;;
    --ple_cpu_offload=*) PLE_CPU_OFFLOAD="${1#*=}" ;;
    --ple_cpu_offload)
      [ $# -ge 2 ] || { echo "错误: --ple_cpu_offload 需要一个值" >&2; exit 1; }
      shift; PLE_CPU_OFFLOAD="$1"
      ;;
    --kv_cache_memory=*) KV_CACHE_MEMORY="${1#*=}" ;;
    --kv_cache_memory)
      [ $# -ge 2 ] || { echo "错误: --kv_cache_memory 需要一个值" >&2; exit 1; }
      shift; KV_CACHE_MEMORY="$1"
      ;;
    --mamba_ssm_dtype=*) MAMBA_SSM_DTYPE="${1#*=}" ;;
    --mamba_ssm_dtype)
      [ $# -ge 2 ] || { echo "错误: --mamba_ssm_dtype 需要一个值" >&2; exit 1; }
      shift; MAMBA_SSM_DTYPE="$1"
      ;;
    --moe_backend=*) MOE_BACKEND="${1#*=}" ;;
    --moe_backend)
      [ $# -ge 2 ] || { echo "错误: --moe_backend 需要一个值" >&2; exit 1; }
      shift; MOE_BACKEND="$1"
      ;;
    --distributed_executor_backend=*) DISTRIBUTED_EXECUTOR_BACKEND="${1#*=}" ;;
    --distributed_executor_backend)
      [ $# -ge 2 ] || { echo "错误: --distributed_executor_backend 需要一个值" >&2; exit 1; }
      shift; DISTRIBUTED_EXECUTOR_BACKEND="$1"
      ;;
    *)
      echo "错误：未知参数: $1" >&2
      echo "提示：运行 ./vllm_run -h 或 ./vllm_run --help 查看帮助" >&2
      exit 1
      ;;
  esac
  shift
done

# ---------- 校验 TP/DP 参数（修改默认值时须同步更新 usage() 帮助文档） ----------
if ! [[ "$TP_SIZE" =~ ^[0-9]+$ ]] || ! [[ "$DP_SIZE" =~ ^[0-9]+$ ]]; then
  echo "[vllm-run] 错误：--tp/--dp 必须是正整数（当前 tp=$TP_SIZE dp=$DP_SIZE）" >&2
  exit 1
fi
if [ $((4 % TP_SIZE)) -ne 0 ]; then
  echo "[vllm-run] 错误：TP=$TP_SIZE 不合法！该模型 kv_heads=4，TP 必须整除 4（只能取 1/2/4）" >&2
  exit 1
fi
if [ -n "${GPU_PIN}" ]; then
  PIN_COUNT=$(echo "${GPU_PIN}" | tr ',' '\n' | wc -l)
  if [ $((TP_SIZE * DP_SIZE)) -ne "$PIN_COUNT" ]; then
    echo "[vllm-run] 错误：TP×DP=$((TP_SIZE*DP_SIZE)) ≠ --gpu_pin 的 GPU 数量 $PIN_COUNT（$GPU_PIN）" >&2
    echo "[vllm-run] 请调整 --tp/--dp 或 --gpu_pin，例如 --gpu_pin \"0,1,2,3\" --tp 4 --dp 1" >&2
    exit 1
  fi
fi

echo "[vllm-run] ===== vLLM 启动脚本 ====="

# ---------- 1. 确定使用的 GPU（手动指定 或 自动检测空闲） ----------
if [ -n "${GPU_PIN}" ]; then
  echo "[vllm-run] 手动指定 GPU：${GPU_PIN}"
  for g in $(echo "${GPU_PIN}" | tr ',' ' '); do
    if ! [[ "$g" =~ ^[0-9]+$ ]] || [ "$g" -gt "$MAX_GPU_INDEX" ]; then
      echo "[vllm-run] 错误：GPU 编号 $g 非法（范围 0-$MAX_GPU_INDEX）"
      exit 1
    fi
  done
  GPU_LIST="${GPU_PIN}"
  GPU_COUNT=$(echo "${GPU_LIST}" | tr ',' '\n' | wc -l)
  # 检查指定卡是否空闲（警告但不强制）
  BUSY=$(nvidia-smi --query-gpu=index,memory.used,utilization.gpu \
    --format=csv,noheader,nounits | \
    awk -F '[ ,]+' -v list="$GPU_LIST" -v mem="$GPU_MEM_FREE_MB" -v util="$GPU_UTIL_MAX" '
      BEGIN { n = split(list, a, ","); for (i = 1; i <= n; i++) m[a[i]] = 1 }
      ($1 in m) && ($2 >= mem || $3 >= util) { printf "%s ", $1 }')
  if [ -n "$BUSY" ]; then
    echo "[vllm-run] 警告：以下指定 GPU 当前不空闲（已被占用）：$BUSY"
  fi
  echo "[vllm-run] 使用 GPU：$GPU_LIST（共 $GPU_COUNT 张，TP=$TP_SIZE × DP=$DP_SIZE）"
else
  NEEDED_GPUS=$((TP_SIZE * DP_SIZE))
  echo "[vllm-run] 正在检测空闲 GPU（需要 $NEEDED_GPUS 张，TP×DP）..."
  FREE_GPUS=$(nvidia-smi --query-gpu=index,memory.used,utilization.gpu \
    --format=csv,noheader,nounits | \
    awk -F '[ ,]+' -v max="$MAX_GPU_INDEX" -v mem="$GPU_MEM_FREE_MB" -v util="$GPU_UTIL_MAX" '
      $1 >= 0 && $1 <= max && $2 < mem && $3 < util { print $1 }' | head -n "$NEEDED_GPUS")

  GPU_COUNT=$(echo "$FREE_GPUS" | wc -w)

  # 校验：一张空闲卡都没有则退出
  if [ "$GPU_COUNT" -eq 0 ]; then
    echo "[vllm-run] 错误：未找到空闲 GPU！当前 GPU 状态："
    nvidia-smi --query-gpu=index,memory.used,utilization.gpu --format=csv
    exit 1
  fi
  if [ "$GPU_COUNT" -lt "$NEEDED_GPUS" ]; then
    echo "[vllm-run] 错误：空闲 GPU 只有 $GPU_COUNT 张（需要 $NEEDED_GPUS 张 = TP×DP）！"
    nvidia-smi --query-gpu=index,memory.used,utilization.gpu --format=csv
    exit 1
  fi
  GPU_LIST=$(echo "$FREE_GPUS" | tr '\n' ',' | sed 's/,$//')
  echo "[vllm-run] 使用 GPU：$GPU_LIST（共 $GPU_COUNT 张，TP=$TP_SIZE × DP=$DP_SIZE）"
fi

# 固定使用配置值，不做显存自适应
echo "[vllm-run] 显存利用率（固定值，不做自动调整）：$GPU_MEM_UTIL"
# ---------- 2. 创建目录（模型缓存/日志，全部在 $HOME 下） ----------
mkdir -p "${VLLM_DIR}/models" "${VLLM_DIR}/logs"

# ---------- 3. 清理旧容器 ----------
echo "[vllm-run] 清理旧容器 $CONTAINER_NAME..."
docker stop "$CONTAINER_NAME" > /dev/null 2>&1 || true
docker rm -f "$CONTAINER_NAME" > /dev/null 2>&1 || true

# ---------- 3.5 模型类型自动识别（dense / MoE / qwen4，一次写好通用） ----------
MODEL_ARCH=""
MODEL_TYPE=""
NUM_EXPERTS=""
HAS_MTP=""
if [ -f "${MODEL_NAME}/config.json" ]; then
  MODEL_ARCH=$(python3 -c "import json;print((json.load(open('${MODEL_NAME}/config.json')).get('architectures') or [''])[0])" 2>/dev/null)
  MODEL_TYPE=$(python3 -c "import json;print(json.load(open('${MODEL_NAME}/config.json')).get('model_type',''))" 2>/dev/null)
  NUM_EXPERTS=$(python3 -c "import json;d=json.load(open('${MODEL_NAME}/config.json'));print(d.get('num_experts') or (d.get('text_config') or {}).get('num_experts') or (d.get('moe_config') or {}).get('num_experts') or '')" 2>/dev/null)
  HAS_MTP=$(ls "${MODEL_NAME}"/mtp*.safetensors 2>/dev/null | head -n 1)
fi
IS_QWEN4=0
case "${MODEL_TYPE}${MODEL_ARCH}" in
  *qwen4*|*Qwen4*) IS_QWEN4=1 ;;
esac
IS_MOE=0
if [ -n "${NUM_EXPERTS}" ] && [ "${NUM_EXPERTS}" -gt 0 ] 2>/dev/null; then
  IS_MOE=1
fi
echo "[vllm-run] 模型识别：arch=${MODEL_ARCH:-?} type=${MODEL_TYPE:-?} experts=${NUM_EXPERTS:-0} mtp=$([ -n "${HAS_MTP}" ] && echo yes || echo no) moe=$IS_MOE qwen4=$IS_QWEN4"
# 镜像自动选择：qwen4 实验架构 → day-0 专用镜像；其他（dense 等）→ nightly 镜像
if [ "${IS_QWEN4}" = "1" ] && [ "${IMAGE_NAME}" = "vllm-user:latest" ]; then
  IMAGE_NAME="docker.m.daocloud.io/vllm/vllm-openai:qwen38-flash-next"
  echo "[vllm-run] 检测到 Qwen4 实验架构，自动切换专用镜像：${IMAGE_NAME}"
fi

# ---------- 4. 构造 vLLM 启动参数 ----------
HOST_PORT="${PORT_MAP%%:*}"
CONTAINER_PORT="${PORT_MAP##*:}"

# 工具调用参数（DSH/GUI 需要，否则带 tools 的请求会 400）：
# qwen3_xml 适配 Qwen3.8 系列（XML 格式工具调用）；若工具解析异常可改 hermes
VLLM_ARGS=(
  "${MODEL_NAME}"
  --host 0.0.0.0
  --port "${CONTAINER_PORT}"
  --served-model-name "${SERVED_NAME}"
  --tensor-parallel-size "${TP_SIZE}"
  --data-parallel-size "${DP_SIZE}"
  --gpu-memory-utilization "${GPU_MEM_UTIL}"
  --max-model-len "${MAX_MODEL_LEN}"
  --max-num-seqs "${MAX_NUM_SEQS}"
  --enable-prefix-caching
  --enable-auto-tool-choice
  --tool-call-parser qwen3_xml
  --reasoning-parser qwen3
)
# MoE 模型：专家并行（block-128 FP8 必需；dense 模型不加）
if [ "${IS_MOE}" = "1" ]; then
  VLLM_ARGS+=(--enable-expert-parallel --moe-backend "${MOE_BACKEND}")
fi
# Qwen4 实验架构（GDN 线性注意力 + n-gram 表）：专属参数
if [ "${IS_QWEN4}" = "1" ]; then
  VLLM_ARGS+=(--mamba-ssm-cache-dtype "${MAMBA_SSM_DTYPE}")
  VLLM_ARGS+=(--kv-cache-dtype bfloat16)
  VLLM_ARGS+=(--kv-cache-memory-bytes "${KV_CACHE_MEMORY}")
  VLLM_ARGS+=(--distributed-executor-backend "${DISTRIBUTED_EXECUTOR_BACKEND}")
fi
if [ "${EAGER_MODE}" = "1" ]; then
  VLLM_ARGS+=(--enforce-eager)
else
  # 性能模式：跳过 FlashInfer kernel 自动调优（GPU benchmark 极慢且易卡，CUDA Graph 收益不受影响）
  if [ "${IS_QWEN4}" = "1" ]; then
    # Qwen4：MTP 投机解码（checkpoint 自带 1 层 MTP）
    VLLM_ARGS+=(--speculative-config '{"method":"mtp","num_speculative_tokens":3}')
  elif [ -n "${HAS_MTP}" ]; then
    # Qwen3 系（dense 带 MTP 权重）：qwen3_5_mtp 投机解码
    VLLM_ARGS+=(--spec-method qwen3_5_mtp --spec-tokens 4 --max-num-batched-tokens "${MAX_BATCHED_TOKENS}")
  fi
fi
if [ -n "${API_KEY}" ]; then
  VLLM_ARGS+=(--api-key "${API_KEY}")
fi

# 本地模型路径 → 只读挂载进容器（容器内外路径一致，直接加载）
MOUNT_ARGS=()
if [[ "${MODEL_NAME}" == /* ]]; then
  MOUNT_ARGS+=(-v "${MODEL_NAME}:${MODEL_NAME}:ro")
fi

# ---------- 5. 启动容器 ----------
echo "[vllm-run] 启动 vLLM 容器（模型：$MODEL_NAME）..."
# PLE（n-gram 表）CPU 卸载：51B 表 ~48GiB 搬到主机内存，GPU 只留核心权重（仅 Qwen4 架构支持）
PLE_ENV=()
if [ "${PLE_CPU_OFFLOAD}" = "1" ] && [ "${IS_QWEN4}" = "1" ]; then
  echo "[vllm-run] PLE CPU 卸载已开启（VLLM_PLE_CPU_OFFLOAD=1，n-gram 表 ~48GiB 进主机内存）"
  PLE_ENV+=(-e VLLM_PLE_CPU_OFFLOAD=1)
  PLE_ENV+=(-e VLLM_PLE_OFFLOAD_READY_TIMEOUT="${PLE_OFFLOAD_READY_TIMEOUT}")
fi
# 拼成 vllm serve 命令字符串（--entrypoint /bin/bash -c 形态，避免不同镜像 entrypoint 差异）
VLLM_CMD="vllm serve"
for arg in "${VLLM_ARGS[@]}"; do
  VLLM_CMD="${VLLM_CMD} '${arg}'"
done
# pidfd_getfd 权限说明（2026-08-30）：PYTORCH_CUDA_ALLOC_CONF=expandable_segments 下，
# PLE 卸载跨进程共享 CUDA tensor 需要 pidfd_getfd 系统调用，容器默认无 CAP_SYS_PTRACE 会 EPERM，故加 --cap-add SYS_PTRACE
docker run -d \
  --name "${CONTAINER_NAME}" \
  --restart always \
  --entrypoint /bin/bash \
  --runtime=nvidia \
  --ipc=host \
  --cap-add SYS_PTRACE \
  -e NVIDIA_VISIBLE_DEVICES="${GPU_LIST}" \
  --shm-size "${SHM_SIZE}" \
  -p "${PORT_MAP}" \
  "${PLE_ENV[@]}" \
  -v "${VLLM_DIR}/models:/root/.cache/huggingface" \
  -v "${VLLM_DIR}/logs:/var/log/vllm" \
  -e HF_HOME=/root/.cache/huggingface \
  -e HF_ENDPOINT="${HF_ENDPOINT}" \
  -e VLLM_LOGGING_LEVEL=INFO \
  -e NCCL_P2P_DISABLE=1 \
  -e NCCL_IB_DISABLE=1 \
  -e NCCL_CUMEM_DISABLE=1 \
  -e PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
  "${MOUNT_ARGS[@]}" \
  "${IMAGE_NAME}" \
  -c "${VLLM_CMD}"

# ---------- 6. 等待服务就绪 ----------
echo "[vllm-run] 等待 vLLM 服务就绪（首次加载模型需要 1~3 分钟）..."
WAIT_SECONDS=0
while true; do
  if curl -sf -m 3 "http://127.0.0.1:${HOST_PORT}/v1/models" > /dev/null 2>&1; then
    echo "[vllm-run] 服务已就绪（等待 ${WAIT_SECONDS} 秒）"
    break
  fi
  # 容器中途退出则直接报错
  if ! docker inspect -f '{{.State.Running}}' "${CONTAINER_NAME}" 2>/dev/null | grep -q true; then
    echo "[vllm-run] 错误：容器已退出！最近日志："
    docker logs --tail 60 "${CONTAINER_NAME}"
    exit 1
  fi
  WAIT_SECONDS=$((WAIT_SECONDS + 2))
  echo "[vllm-run] 等待服务启动... ${WAIT_SECONDS} s"
  if [ $WAIT_SECONDS -ge "$TIMEOUT_SECONDS" ]; then
    echo "[vllm-run] 错误：服务启动超时！最近日志："
    docker logs --tail 40 "${CONTAINER_NAME}"
    exit 1
  fi
  sleep 2
done

# ---------- 7. 验证启动结果 ----------
if docker ps | grep -q "${CONTAINER_NAME}"; then
  echo -e "[vllm-run] 启动成功！\n  - 容器名：${CONTAINER_NAME}\n  - GPU：${GPU_LIST}（TP=${GPU_COUNT}）\n  - API 地址：http://127.0.0.1:${HOST_PORT}/v1\n  - 对外模型名：${SERVED_NAME}\n  - 测试命令：curl http://127.0.0.1:${HOST_PORT}/v1/models\n  - 查看日志：docker logs -f ${CONTAINER_NAME}\n  - 停止服务：docker stop ${CONTAINER_NAME}"
else
  echo "[vllm-run] 错误：容器启动失败！"
  docker logs "${CONTAINER_NAME}"
  exit 1
fi
